{
  "manifest_version": 3,
  "name": "Context Explain",
  "version": "2.3.3",
  "description": "Understand anything as you read: context-aware AI explanations, translations & follow-up Q&A without leaving the page. BYO API key.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "https://auth.openai.com/*",
    "https://api.openai.com/*"
  ],
  "sandbox": {
    "pages": [
      "mermaid-sandbox.html"
    ]
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/marked.min.js",
        "lib/katex.min.js",
        "lib/prompts.js",
        "selection-context.js",
        "frame-context.js",
        "content.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/katex.min.css",
        "lib/fonts/*.woff2",
        "lib/mermaid.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "siwc/callback.html"
      ],
      "matches": [
        "http://127.0.0.1/*",
        "https://auth.openai.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "121"
}
